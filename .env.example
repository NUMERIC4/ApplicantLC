# ApplicantLC Configuration
# NVIDIA NIM Open Models API settings
# Backend-only secret. Never put this value in browser code or commit it.
# Sign up at https://build.nvidia.com/ to get your free API key with complimentary credits.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL_NAME="nvidia/nemotron-3.5-lightning-30b-a3b"
# Maximum normalized job-source characters sent to strict extraction. Longer
# sources are visibly truncated in the transient review metadata.
JOB_SOURCE_MAX_CHARS=16000
CV_MAX_FILE_MB=10
CV_SOURCE_MAX_CHARS=40000
# Application-controlled, ignored local storage for original applicant PDFs.
APPLICANT_FILES_DIR="data/applicant_files"
NVIDIA_REQUEST_TIMEOUT_SECONDS=110

# Optional Affinda comparison spike. The default production CV flow remains local
# layout parsing followed by NVIDIA extraction; this only enables explicit previews.
RESUME_PARSER_PROVIDER=local
AFFINDA_API_KEY=""
AFFINDA_BASE_URL="https://resume-parser.eu1.affinda.com"
AFFINDA_REQUEST_TIMEOUT_SECONDS=60

# Alternative tested models on NVIDIA NIM:
# - nvidia/nemotron-3-nano-30b-a3b
# - nvidia/nemotron-4-340b-instruct

# Application Settings
DATABASE_URL="sqlite+aiosqlite:///./applicant_lc.db"
APP_HOST="127.0.0.1"
APP_PORT=8000
DEBUG=true
